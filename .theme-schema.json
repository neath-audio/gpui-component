            "string",
            "null"
          ]
        },
        "table_row_selected_border": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "type": [
            "string",
            "null"
          ]
        },
        "caret": {
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
