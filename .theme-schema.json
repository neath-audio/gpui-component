{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThemeSet",
  "description": "Represents a theme configuration.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of the theme set.",
      "type": "string",
      "default": ""
    },
    "author": {
      "description": "The author of the theme.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "url": {
      "description": "The URL of the theme.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "themes": {
      "description": "The theme list of the theme set.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThemeConfig"
      },
      "default": []
    }
  },
  "$defs": {
    "ThemeConfig": {
      "type": "object",
      "properties": {
        "is_default": {
          "description": "Whether this theme is the default theme.",
          "type": "boolean",
          "default": false
        },
        "name": {
          "description": "The name of the theme.",
          "type": "string",
          "default": ""
        },
        "mode": {
          "description": "The mode of the theme, default is light.",
          "$ref": "#/$defs/ThemeMode",
          "default": "light"
        },
        "font.size": {
          "description": "The base font size, default is 16.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "font.family": {
          "description": "The base font family, default is system font: `.SystemUIFont`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "mono_font.family": {
          "description": "The monospace font family, default is platform specific:\n- macOS: `Menlo`\n- Windows: `Consolas`\n- Linux: `DejaVu Sans Mono`",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "mono_font.size": {
          "description": "The monospace font size, default is 13.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "radius": {
          "description": "The border radius for general elements, default is 6.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "radius.lg": {
          "description": "The border radius for large elements like Dialogs and Notifications, default is 8.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "shadow": {
          "description": "Set shadows in the theme, for example the Input and Button, default is true.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "colors": {
          "description": "The colors of the theme.",
          "$ref": "#/$defs/ThemeConfigColors",
          "default": {}
        },
        "highlight": {
          "description": "The highlight theme, this part is combilbility with `style` section in Zed theme.\n\nhttps://github.com/zed-industries/zed/blob/f50041779dcfd7a76c8aec293361c60c53f02d51/assets/themes/ayu/ayu.json#L9",
          "anyOf": [
            {
              "$ref": "#/$defs/HighlightThemeStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "ThemeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "ThemeConfigColors": {
      "description": "Color overrides for the 38 theme roles.\n\nDeserialize accepts the new field names and the spec load-map's old\ndotted keys (first present wins). Serialize emits only set field names.",
      "type": "object",
      "properties": {
        "bg": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "type": [
