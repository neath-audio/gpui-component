            "null"
          ]
        },
        "danger_strong": {
          "type": [
            "string",
            "null"
          ]
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        },
        "warning_muted": {
          "type": [
            "string",
            "null"
          ]
        },
        "success": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_muted": {
          "type": [
            "string",
            "null"
          ]
        },
        "busy": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "row_hover": {
          "type": [
            "string",
            "null"
          ]
        },
        "row_selected": {
          "type": [
            "string",
            "null"
