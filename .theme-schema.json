            {
              "type": "null"
            }
          ]
        },
        "syntax": {
          "$ref": "#/$defs/SyntaxColors"
        }
      },
      "required": [
        "syntax"
      ]
    },
    "Rgba": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
