#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

# Input algorithms, IME protocol, inline tokens and styled InputGroup behavior.
cargo test -p gpui-base -p gpui-neath \
  --features gpui-neath/test-support --lib --locked input::

# Real component workflows, focus routing, touch selection and key-event helpers.
cargo test -p gpui-kit --features test-support,assets --locked \
  --test integration -- input:: input_focus:: touch_selection:: interactions:: \
  composition_helpers::
